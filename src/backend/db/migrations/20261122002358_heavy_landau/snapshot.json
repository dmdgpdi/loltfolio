    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "match_collection_jobs",
        "name": "match_collection_jobs_identity_check",
        "value": "\"job_id\" <> '' AND \"job_id\" = btrim(\"job_id\") AND \"puuid\" <> '' AND \"puuid\" = btrim(\"puuid\") AND \"queue_id\" IN (400, 420, 430, 440, 450, 480, 490, 700, 720)",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "match_collection_jobs",
        "name": "match_collection_jobs_attempts_check",
        "value": "\"max_attempts\" BETWEEN 1 AND 9007199254740991 AND \"attempt_count\" BETWEEN 0 AND \"max_attempts\"",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "match_collection_jobs",
        "name": "match_collection_jobs_time_check",
        "value": "\"updated_at\" >= \"requested_at\" AND (\"started_at\" IS NULL OR \"started_at\" BETWEEN \"requested_at\" AND \"updated_at\")",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "match_collection_jobs",
        "name": "match_collection_jobs_selection_check",
        "value": "\"selected_match_ids\" IS NULL OR CASE WHEN jsonb_typeof(\"selected_match_ids\") = 'array' THEN jsonb_array_length(\"selected_match_ids\") <= 20 ELSE false END",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "match_collection_jobs",
        "name": "match_collection_jobs_state_check",
        "value": "\n    (\"status\" = 'QUEUED' AND \"attempt_count\" = 0 AND \"started_at\" IS NULL AND \"finished_at\" IS NULL AND \"next_attempt_at\" IS NULL AND \"outcome\" IS NULL AND \"selected_match_ids\" IS NULL AND \"last_failure\" IS NULL AND \"updated_at\" = \"requested_at\") OR\n    (\"status\" = 'RUNNING' AND \"attempt_count\" > 0 AND \"started_at\" IS NOT NULL AND \"finished_at\" IS NULL AND \"next_attempt_at\" IS NULL AND \"outcome\" IS NULL) OR\n    (\"status\" = 'RETRY_WAIT' AND \"attempt_count\" > 0 AND \"attempt_count\" < \"max_attempts\" AND \"started_at\" IS NOT NULL AND \"finished_at\" IS NULL AND \"next_attempt_at\" IS NOT NULL AND \"next_attempt_at\" >= \"updated_at\" AND \"last_failure\" IS NOT NULL AND \"outcome\" IS NULL) OR\n    (\"status\" IN ('FINALIZING', 'SUCCEEDED', 'PARTIALLY_SUCCEEDED', 'FAILED') AND \"attempt_count\" > 0 AND \"started_at\" IS NOT NULL AND \"next_attempt_at\" IS NULL AND \"outcome\" IS NOT NULL AND\n      CASE WHEN \"status\" = 'FINALIZING' THEN \"finished_at\" IS NULL ELSE \"finished_at\" IS NOT NULL AND \"finished_at\" = \"updated_at\" AND (\"outcome\"->>'status') IS NOT DISTINCT FROM \"status\" END)\n  ",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "match_collection_jobs",
        "name": "match_collection_jobs_lease_check",
        "value": "\n    CASE WHEN \"status\" IN ('RUNNING', 'FINALIZING') THEN\n      \"execution_token\" IS NOT NULL AND length(btrim(\"execution_token\")) > 0 AND \"lease_expires_at\" IS NOT NULL AND \"execution_purpose\" IS NOT DISTINCT FROM CASE WHEN \"status\" = 'RUNNING' THEN 'COLLECT' ELSE 'FINALIZE' END\n    ELSE \"execution_token\" IS NULL AND \"execution_purpose\" IS NULL AND \"lease_expires_at\" IS NULL END\n  ",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "match_syncs",
        "name": "match_syncs_active_job_status_check",
        "value": "\"active_job_id\" IS NULL OR \"status\" = 'IN_PROGRESS'",
        "entityType": "checks"
      }
    }
  ]
}
